# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# (Opsional) Token rahasia webhook untuk keamanan header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_SECRET_TOKEN="your_custom_secret_token_here"

# ==========================================
# CLOUDFLARE CONFIGURATION
# ==========================================
# Dapatkan Account ID dari Cloudflare Dashboard (kanan bawah di Overview)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"

# Dapatkan API Token dari Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token (Template: Edit Cloudflare Workers)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# Nama index Vectorize yang dibuat via: npx wrangler vectorize create rag-tele-index --dimensions=1024 --metric=cosine
VECTORIZE_INDEX_NAME="rag-tele-index"

# Embedding Model (1024 dimensions)
EMBEDDING_MODEL="@cf/baai/bge-m3"

# LLM Model untuk Chat / RAG
DEFAULT_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# ==========================================
# DASHBOARD MONITORING STOK (HTTP BASIC AUTH)
# ==========================================
# Login untuk halaman /monitor dan API perubahan stok.
# Set juga sebagai secret di Cloudflare:
#   npx wrangler secret put ADMIN_PASSWORD
ADMIN_USER="admin"
ADMIN_PASSWORD="ganti-dengan-password-yang-kuat"

# Database D1 untuk stok (dibuat dengan: npx wrangler d1 create rag-tele-stock)
# Binding DB sudah diatur di wrangler.jsonc. Worker membuat tabel & seed otomatis.

